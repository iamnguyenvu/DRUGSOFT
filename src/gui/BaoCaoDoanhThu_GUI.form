    <Component class="javax.swing.JButton" name="btnLast">
      <AuxValues>
        <AuxValue name="JavaCodeGenerator_AddingCodePost" type="java.lang.String" value="btnFirst.addActionListener(e -&gt; {&#xa;    currentPage = 1;&#xa;        loadDataBasedOnSelection();&#xa;});&#xa;&#xa;btnPrevious.addActionListener(e -&gt; {&#xa;    if (currentPage &gt; 1) {&#xa;        currentPage--;&#xa;        loadDataBasedOnSelection();&#xa;    }&#xa;});&#xa;&#xa;btnNext.addActionListener(e -&gt; {&#xa;    if (currentPage &lt; totalPages) {&#xa;        currentPage++;&#xa;        loadDataBasedOnSelection();&#xa;    }&#xa;});&#xa;&#xa;btnLast.addActionListener(e -&gt; {&#xa;    currentPage = totalPages;&#xa;    loadDataBasedOnSelection();&#xa;});"/>
        <AuxValue name="JavaCodeGenerator_CreateCodeCustom" type="java.lang.String" value="new javax.swing.JButton(new FlatSVGIcon(&quot;gui/icon/last-page.svg&quot;, 0.03f))"/>
